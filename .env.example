# Copy this file to .env for local development. Never commit .env.
PORT=3000
NODE_ENV=development

# Long random string used to sign the application JWT
JWT_SECRET=replace-with-a-long-random-string

# From your GitHub OAuth App (Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# Must exactly match the "Authorization callback URL" in the GitHub OAuth App
# Local:  http://localhost:3000/auth/github/callback
# Render: https://YOUR-APP.onrender.com/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Where the browser is sent after login. Leave empty when React is served by
# Express (npm run build && npm start, and on Render). Only set it to
# http://localhost:5173 if you use the Vite dev server (npm run dev:client).
CLIENT_URL=

# Optional: SQLite file location
DB_PATH=./data/capsules.db
